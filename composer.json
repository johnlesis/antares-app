{
    "name": "fatjon-lleshi/antares-app",
    "description": "Skeleton application for the Antares framework",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "fatjon-lleshi/antares": "^0.2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "minimum-stability": "stable",
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:8080 -t public public/index.php"
        ],
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    }
}
