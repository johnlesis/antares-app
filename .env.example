APP_NAME=Antares
APP_ENV=local
APP_DEBUG=true      # error details in 500 responses (default: on, off when APP_ENV=production)
# APP_DOCS=true     # /openapi.json and /docs (default: on, off when APP_ENV=production)
APP_URL=http://localhost:8080

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_db
DB_USERNAME=your_user
DB_PASSWORD=your_password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=
# DB_DSN=           # optional: a full PDO connection string, used instead of the DB_* settings above

# MAX_REQUESTS=500  # FrankenPHP worker mode: restart each worker after this many requests

# CORS (see config/cors.php)
CORS_ORIGIN=*
CORS_CREDENTIALS=false

# Swoole (swoole.php)
# SWOOLE_HOST=0.0.0.0
# SWOOLE_PORT=8000
